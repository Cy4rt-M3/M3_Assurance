# ── Postgres ─────────────────────────────────────────────
POSTGRES_USER=assurance
POSTGRES_PASSWORD=assurance
POSTGRES_DB=assurance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── App (derived — do not change unless you changed above) ─
DATABASE_URL=postgresql+asyncpg://assurance:assurance@localhost:5432/assurance
DATABASE_TEST_URL=postgresql+asyncpg://assurance:assurance@localhost:5432/assurance_test
REDIS_URL=redis://localhost:6379/0

# ── Service ports (10001-10007) ──────────────────────────
PORT_CONTROL_MAPPING=10001
PORT_EVIDENCE_AGGREGATOR=10002
PORT_GAP_ANALYZER=10003
PORT_RESILIENCE_SCORER=10004
PORT_REPORT_GENERATOR=10005
PORT_FRAMEWORK_REGISTRY=10006
PORT_REPORT_PUBLISHER=10007

# MongoDB - Pod 1 Controls
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=m3_controls
MONGODB_COLLECTION=controls
MONGODB_PORT=27017
CONTROLS_FILE=data/controls/Pod_Nova_Framework_Registry_updated.xlsx
CONTROLS_SHEET=Master Controls
