DATABASE_URL="file:./db/custom.db"

# M3 Assurance backend wiring -------------------------------------------------
# The dashboard proxies the seven microservices through /api/m3/{service}/{path}
# (see src/app/api/m3/[...route]/route.ts). Override the base URL and/or port
# per service when the backend is not running on 127.0.0.1:<port>.
#
# M3_BASE_CONTROL_MAPPING=http://127.0.0.1
# M3_PORT_CONTROL_MAPPING=10001
# M3_BASE_EVIDENCE_AGGREGATOR=http://127.0.0.1
# M3_PORT_EVIDENCE_AGGREGATOR=10002
# M3_BASE_GAP_ANALYZER=http://127.0.0.1
# M3_PORT_GAP_ANALYZER=10003
# M3_BASE_RESILIENCE_SCORER=http://127.0.0.1
# M3_PORT_RESILIENCE_SCORER=10004
# M3_BASE_REPORT_GENERATOR=http://127.0.0.1
# M3_PORT_REPORT_GENERATOR=10005
# M3_BASE_FRAMEWORK_REGISTRY=http://127.0.0.1
# M3_PORT_FRAMEWORK_REGISTRY=10006
# M3_BASE_REPORT_PUBLISHER=http://127.0.0.1
# M3_PORT_REPORT_PUBLISHER=10007

# Default engagement shown on first load. The engagement selector in the
# dashboard header lets users switch to any engagement returned by the backend.
# NEXT_PUBLIC_M3_ENGAGEMENT_ID=ENG-2026-003