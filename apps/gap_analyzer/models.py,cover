> """Pydantic models for the Gap Analyzer service."""
  
> from pydantic import BaseModel, Field
  
  
> class GapAnalysis(BaseModel):
>     analysis_id: str
>     engagement_id: str
>     control_id: str
>     gap_type: str = Field(
>         ..., description="uncovered_control | missed_detection | evidence_gap"
>     )
>     priority: int = Field(..., ge=1, le=5, description="1=Critical … 5=Informational")
>     remediation: str
  
  
> class GapSummary(BaseModel):
>     engagement_id: str
>     total_gaps: int
>     critical_gaps: int
>     gaps: list[GapAnalysis]
  
  
> class GapRequest(BaseModel):
>     engagement_id: str
>     framework_ids: list[str] = Field(default_factory=list)
